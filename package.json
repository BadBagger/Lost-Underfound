{
  "name": "lost-underfound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "python scripts/generate_assets.py && python scripts/generate_production_assets.py",
    "assets:scaffold": "python scripts/generate_assets.py",
    "assets:production": "python scripts/generate_production_assets.py",
    "qa:placeholder": "python tools/check_registration.py frames art/qa-placeholder/registration.json --onion-skin art/qa-placeholder/onion.png",
    "qa:broken": "python tools/check_registration.py frames art/qa-broken/registration.json",
    "qa:pip": "python tools/check_registration.py frames art/pip-walk/registration.json --onion-skin art/pip-walk/onion.png",
    "qa:bottlecap": "python tools/check_registration.py frames art/old-bottlecap-idle/registration.json --onion-skin art/old-bottlecap-idle/onion.png",
    "qa:bramble": "python tools/check_registration.py frames art/bramble-idle/registration.json --onion-skin art/bramble-idle/onion.png",
    "qa:scuttle": "python tools/check_registration.py frames art/scuttle-walk/registration.json --onion-skin art/scuttle-walk/onion.png",
    "qa:grommet-placeholder": "python tools/check_registration.py frames art/grommet-idle/registration.json --onion-skin art/grommet-idle/onion.png",
    "qa:prod:pip-walk": "python tools/check_registration.py frames art/act01-production/characters/pip/walk/registration.json --onion-skin art/act01-production/characters/pip/walk/onion.png",
    "qa:prod:pip-idle": "python tools/check_registration.py frames art/act01-production/characters/pip/idle/registration.json --onion-skin art/act01-production/characters/pip/idle/onion.png",
    "qa:prod:pip-dust": "python tools/check_registration.py frames art/act01-production/characters/pip/dust-reach/registration.json --onion-skin art/act01-production/characters/pip/dust-reach/onion.png",
    "qa:prod:pip-toll": "python tools/check_registration.py frames art/act01-production/characters/pip/toll-paid/registration.json --onion-skin art/act01-production/characters/pip/toll-paid/onion.png",
    "qa:prod:bramble-idle": "python tools/check_registration.py frames art/act01-production/characters/bramble/idle/registration.json --onion-skin art/act01-production/characters/bramble/idle/onion.png",
    "qa:prod:bramble-talk": "python tools/check_registration.py frames art/act01-production/characters/bramble/talk/registration.json --onion-skin art/act01-production/characters/bramble/talk/onion.png",
    "qa:prod:bottlecap-idle": "python tools/check_registration.py frames art/act01-production/characters/old-bottlecap/idle/registration.json --onion-skin art/act01-production/characters/old-bottlecap/idle/onion.png",
    "qa:prod:bottlecap-refused": "python tools/check_registration.py frames art/act01-production/characters/old-bottlecap/toll-refused/registration.json --onion-skin art/act01-production/characters/old-bottlecap/toll-refused/onion.png",
    "qa:prod:bottlecap-paid": "python tools/check_registration.py frames art/act01-production/characters/old-bottlecap/toll-paid/registration.json --onion-skin art/act01-production/characters/old-bottlecap/toll-paid/onion.png",
    "qa:prod:scuttle-dash": "python tools/check_registration.py frames art/act01-production/characters/scuttle/dash/registration.json --onion-skin art/act01-production/characters/scuttle/dash/onion.png",
    "qa:prod:dust": "python tools/check_registration.py frames art/act01-production/props/dust-clump-reveal/registration.json --onion-skin art/act01-production/props/dust-clump-reveal/onion.png",
    "qa:prod:grate": "python tools/check_registration.py frames art/act01-production/props/grate-open/registration.json --onion-skin art/act01-production/props/grate-open/onion.png",
    "qa:production": "npm run qa:prod:pip-walk && npm run qa:prod:pip-idle && npm run qa:prod:pip-dust && npm run qa:prod:pip-toll && npm run qa:prod:bramble-idle && npm run qa:prod:bramble-talk && npm run qa:prod:bottlecap-idle && npm run qa:prod:bottlecap-refused && npm run qa:prod:bottlecap-paid && npm run qa:prod:scuttle-dash && npm run qa:prod:dust && npm run qa:prod:grate",
    "qa:cast": "python tools/check_registration.py cast-scale art/cast_scale.json",
    "qa:layers": "python tools/check_scene_layers.py",
    "qa:ags:room1": "python tools/check_ags_room1_geometry.py",
    "qa": "npm run qa:placeholder && npm run qa:pip && npm run qa:bottlecap && npm run qa:bramble && npm run qa:scuttle && npm run qa:grommet-placeholder && npm run qa:production && npm run qa:cast && npm run qa:layers && npm run qa:ags:room1",
    "test": "npm run qa && tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "vite": "^7.0.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {}
}
